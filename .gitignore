# macOS metadata
.DS_Store

# Repository-specific Python virtual environment
.venv/

# Python bytecode and cache directories
__pycache__/
*.py[cod]

# Test caches
.pytest_cache/

# Quarto-generated working files
.quarto/
_freeze/

# Rendered Quarto website
docs/

# Generated processed data; retain the directory placeholder
data/processed/*
!data/processed/.gitkeep

# Runtime logs; retain the directory placeholder
logs/*
!logs/.gitkeep

# Generated results and figures; retain the directory placeholder
results/*
!results/.gitkeep
/.quarto/
